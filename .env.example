# ASMT Aegis - environment variables
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored; never commit real secrets to this file or any other.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server only. Bypasses Row Level Security entirely - never prefix with
# NEXT_PUBLIC_, never send to the browser, never log it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# AI classification (optional - the deterministic rule engine works without it
# and is never overridden downward by the AI; see lib/classify.ts)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Telegram alerting
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Negative for a supergroup/channel id.
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# ---------------------------------------------------------------------------
# Responder dashboard authentication
# ---------------------------------------------------------------------------
# Shared PIN fallback, used when Supabase magic-link email is unavailable or
# rate-limited. Pick a long, unguessable value - it is brute-force throttled
# server-side, but a short PIN is still weaker than it needs to be.
STAFF_PIN=your_staff_pin_here

# At least one of these two must be set for magic-link sign-in to work at
# all - see lib/staff-allowlist.ts. Without either, /api/staff/sso refuses
# every sign-in and only the PIN path is available. This exists because
# Supabase magic-link sign-up is open by default: without an allow-list,
# anyone could type their own email into the sign-in form and receive full
# staff access.
STAFF_EMAIL_DOMAIN=your-college.edu.in
STAFF_EMAIL_ALLOWLIST=admin@example.com,warden@example.com

# ---------------------------------------------------------------------------
# Internal service-to-service calls
# ---------------------------------------------------------------------------
# Lets /api/report skip re-applying rate limiting when it calls /api/classify
# internally, since that request was already rate limited at intake. Any long
# random string; generate with `openssl rand -hex 32`.
INTERNAL_API_SECRET=your_random_internal_secret_here

# Vercel Cron sends this in the Authorization header when it calls
# /api/escalate and /api/safe-walk/sweep on a schedule. Optional locally.
CRON_SECRET=your_random_cron_secret_here

# ---------------------------------------------------------------------------
# Public configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SECURITY_PHONE=+910000000000
# The canonical public URL. Printed QR codes encode this - it must be the
# stable production domain, not a per-deployment preview URL.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
